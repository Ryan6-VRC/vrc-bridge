# Generated SteamVR action manifest + bindings (recreated at runtime by config.py)
steamvr_files/

# Local tuning overrides (see src/vrbridge/settings.py)
vrbridge.toml

# Wardrobe manifests: they hold your own avatar ids (see wardrobe.example.toml)
wardrobe/

# Quant-channel manifests: installed copies of files the quant-channel generator
# emits (in a source checkout app_base_dir() is the repo root, so the default
# [quantchannel] manifest_dir lands here)
manifests/

# Python cache / build
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.*

# Logs. logs/ is the bridge's own per-run files, whose rollover (.log.1) the glob misses
*.log
logs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache

# IDE / editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
